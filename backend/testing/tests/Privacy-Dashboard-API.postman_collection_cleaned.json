          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{marketplace_ingest_token}}"
              }
            ],
            "url": "{{baseURL}}/api/integrations/marketplace/apps",
            "body": {
              "mode": "raw",
              "raw": "{\"id\": \"{{marketplace_app_id}}\", \"name\": \"{{marketplace_app_title}}\", \"description\": \"Marketplace ingestion test app\", \"owner_email\": \"{{dc_email}}\", \"delegates_email\": [\"{{delegate_email}}\"], \"available_consents\": [\"processing of personal information to provide the service\", \"sharing data with analytics service\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var suffix = Date.now().toString() + \"-\" + Math.floor(Math.random() * 10000).toString();",
                  "pm.collectionVariables.set(\"marketplace_app_id\", \"com.marketplace.apitest-\" + suffix);",
                  "pm.collectionVariables.set(\"marketplace_app_title\", \"Marketplace API Test \" + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Response status code is 201\", function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Verify Marketplace Ingested App In Managed List",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseURL}}/api/applications/managed"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Response status code is 200\", function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "var data = pm.response.json();",
                  "var targetId = pm.collectionVariables.get(\"marketplace_app_id\");",
                  "var found = data.find(function (item) {",
                  "  return item.application && item.application.name === targetId;",
                  "});",
                  "pm.test(\"Ingested marketplace app is present\", function () {",
                  "  pm.expect(found).to.not.eql(undefined);",
                  "});",
                  "pm.test(\"Ingested app owner is the expected data controller\", function () {",
                  "  pm.expect(found.owner).to.have.property(\"email\", pm.collectionVariables.get(\"dc_email\"));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
