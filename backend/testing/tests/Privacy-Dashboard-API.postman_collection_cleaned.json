        {
          "name": "Handle Request - Missing Response Field Regression",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseURL}}/api/requests/handle/{{missing_request_uuid}}",
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"HANDLED\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var uuidv4 = function () {",
                  "  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {",
                  "    var r = Math.random() * 16 | 0;",
                  "    var v = c === 'x' ? r : (r & 0x3 | 0x8);",
                  "    return v.toString(16);",
                  "  });",
                  "};",
                  "pm.collectionVariables.set('missing_request_uuid', uuidv4());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Response status code is 404 (no TypeError 500)\", function () { pm.expect(pm.response.code).to.eql(404); });",
                  "var body = pm.response.json();",
                  "pm.test(\"Error payload is returned\", function () {",
                  "  pm.expect(body).to.have.property('code', 404);",
                  "  pm.expect(body).to.have.property('message');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
