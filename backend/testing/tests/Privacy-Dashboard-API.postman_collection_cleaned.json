            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseURL}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"\", \"password\": \"x\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Response status code is 422\", function () { pm.expect(pm.response.code).to.eql(422); });",
                  "var body = pm.response.json();",
                  "pm.test(\"Response has validation errors on email\", function () {",
                  "  pm.expect(body).to.have.property('code', 422);",
                  "  pm.expect(body).to.have.property('errors');",
                  "  pm.expect(body.errors).to.have.property('json');",
                  "  pm.expect(body.errors.json).to.have.property('email');",
                  "});"
                ]
              }
            }
          ]
        },
