      "name": "Applications API",
      "item": [
        {
          "name": "List Managed Applications",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseURL}}/api/applications/managed"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Response status code is 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Managed applications is an array\", function () {",
                  "  pm.expect(data).to.be.an('array');",
                  "});",
                  "if (data.length > 0) {",
                  "  var first = data[0];",
                  "  pm.collectionVariables.set('managed_application_uuid', first.application.uuid);",
                  "  pm.collectionVariables.set('managed_application_name', first.application.name);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Application (Manual)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseURL}}/api/applications",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"{{new_app_short_name}}\", \"description\": \"Application generated by Postman automated tests\", \"available_consents\": [\"processing of personal information to provide the service\", \"sharing data with analytics service\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var suffix = Date.now().toString() + '-' + Math.floor(Math.random() * 10000).toString();",
                  "pm.collectionVariables.set('new_app_short_name', 'apitest-' + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Response status code is 201\", function () { pm.expect(pm.response.code).to.eql(201); });",
                  "var body = pm.response.json();",
                  "var shortName = pm.collectionVariables.get('new_app_short_name');",
                  "pm.test(\"Created application structure is valid\", function () {",
                  "  pm.expect(body).to.have.property('application');",
                  "  pm.expect(body.application).to.have.property('uuid');",
                  "  pm.expect(body.application).to.have.property('name', 'com.privacydashboard.' + shortName);",
                  "  pm.expect(body.application).to.have.property('title', shortName);",
                  "  pm.expect(body).to.have.property('owner');",
                  "  pm.expect(body.owner).to.have.property('email', pm.collectionVariables.get('dc_email'));",
                  "  pm.expect(body).to.have.property('data_controllers');",
                  "  pm.expect(body.data_controllers).to.be.an('array');",
                  "});",
                  "pm.collectionVariables.set('created_application_uuid', body.application.uuid);",
                  "pm.collectionVariables.set('created_application_id', body.application.name);",
                  "pm.collectionVariables.set('created_application_title', body.application.title);",
                  "pm.collectionVariables.set('managed_application_uuid', body.application.uuid);",
                  "pm.collectionVariables.set('managed_application_name', body.application.name);"
                ]
              }
            }
          ]
        },
