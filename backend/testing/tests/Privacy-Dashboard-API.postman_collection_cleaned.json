    {
      "name": "Messages API",
      "item": [
        {
          "name": "Send Message To Contact",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseURL}}/api/messages/send",
            "body": {
              "mode": "raw",
              "raw": "{\"content\": \"{{sent_message_content}}\", \"receiver_uuid\": \"{{contact_uuid}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sent_message_content', 'API test message ' + Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Response status code is 201\", function () { pm.expect(pm.response.code).to.eql(201); });",
                  "var body = pm.response.json();",
                  "pm.test(\"Message response has sender and receiver\", function () {",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body).to.have.property('sender_uuid');",
                  "  pm.expect(body).to.have.property('receiver_uuid', pm.collectionVariables.get('contact_uuid'));",
                  "  pm.expect(body.message).to.have.property('content', pm.collectionVariables.get('sent_message_content'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Message History With Contact",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseURL}}/api/messages/history/{{contact_uuid}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Response status code is 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "var data = pm.response.json();",
                  "pm.test(\"History is an array\", function () { pm.expect(data).to.be.an('array'); });",
                  "var expected = pm.collectionVariables.get('sent_message_content');",
                  "var found = data.some(function (entry) { return entry.message && entry.message.content === expected; });",
                  "pm.test(\"History contains the sent message\", function () { pm.expect(found).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
