	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"const csrfToken = pm.environment.get('csrfToken');\r",
					"if (csrfToken) {\r",
					"  pm.request.headers.upsert({\r",
					"    key: 'X-CSRF-TOKEN',\r",
					"    value: csrfToken\r",
					"  });\r",
					"} else {\r",
					"  pm.request.headers.remove('X-CSRF-TOKEN');\r",
					"}\r",
					""
				]
			}
		},
