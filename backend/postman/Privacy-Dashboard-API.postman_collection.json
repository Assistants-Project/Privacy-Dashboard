	"item": [
		{
			"name": "Authentication API",
			"item": [
				{
					"name": "Unexisting User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Response status code is 401\", function () {\r",
									"    pm.expect(pm.response.code).to.eql(401);\r",
									"});\r",
									"\r",
									"const responseData = pm.response.json();\r",
									"\r",
									"pm.test(\"Response has required fields: code, message, and status\", function () {   \r",
									"    pm.expect(responseData).to.be.an('object');\r",
									"    pm.expect(responseData).to.have.all.keys('code', 'message', 'status');\r",
									"});\r",
									"\r",
									"pm.test(\"Code is equal to 401\", function () {\r",
									"    pm.expect(responseData.code).to.eql(401);\r",
									"});\r",
									"\r",
									"pm.test(\"Message is equal to 'Invalid username or password'\", function () {\r",
									"    pm.expect(responseData.message).to.eql('Invalid username or password');\r",
									"});\r",
									"\r",
									"pm.test(\"Status is equal to 'Unauthorized'\", function () {\r",
									"    pm.expect(responseData.status).to.eql('Unauthorized');\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"email\": \"user@example.com\",\r\n    \"password\": \"string\"\r\n}",
